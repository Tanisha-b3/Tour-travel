# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/travel-tour

# Frontend
Frontend_URL=http://localhost:5173

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email (Nodemailer) — leave SMTP_HOST empty to log emails to console instead of sending.
# For Gmail: use smtp.gmail.com and an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# AI (Groq) — leave GROQ_API_KEY empty to disable AI features.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7
GROQ_TIMEOUT_MS=25000

# Cloudinary (image uploads)
# Get credentials at https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
